API_PORT=8080
WEB_PORT=5173
ASPNETCORE_ENVIRONMENT=Development

# Seeder. Off in production; on here because there is no physical fleet yet.
SEEDER_ENABLED=true
SEEDER_CONTROLS=true
SEEDER_SITES=4
SEEDER_DEVICES_PER_SITE=25
SEEDER_INTERVAL_MS=1000

# Ingest queue depth. Lower this to watch backpressure engage.
INGEST_QUEUE_CAPACITY=65536

# Only used with --profile storage.
POSTGRES_USER=smartx
POSTGRES_PASSWORD=change-me
